/* Warcraft III units in place of the villagers (PC/Android only).  Units come from villagers.bin
 * (tools/make_villager_assets.py); every villager gets a unit from the roster by town, personality and name. */
#ifdef TARGET_PC
#ifndef PC_VILLAGERS_INC
#define PC_VILLAGERS_INC
#include <stdio.h>
#include <string.h>

extern char* getenv(const char*);
extern void* malloc(size_t);
extern void* calloc(size_t, size_t);
extern int posix_memalign(void**, size_t, size_t);
extern int mNpc_GetNpcLooks(ACTOR* actor);

typedef struct { char name[32]; f32 scale; int nmesh, nslots, nfr[3]; const u8* meshes; const s16* frames[3]; } pc_vil_unit;
typedef struct { int unit, npc; Vtx** slotv; Gfx* dl; } pc_vil_inst;

static pc_vil_unit* s_vu = NULL;
static int s_vu_n = 0, s_vu_tried = 0;
static const u8* s_vu_roster = NULL;
static u8* s_vph[4096];
static pc_vil_inst s_vi[40];
static int s_vi_next = 0;

static void* pc_vil_amalloc(size_t al, size_t n) { void* p = NULL; if (posix_memalign(&p, al, n) != 0) return NULL; return p; }

static u8* pc_vil_placeholder(int k) {
    u32 st;
    int i;
    if (k < 0 || k >= 4096) k = 0;
    if (s_vph[k] == NULL) {
        u8* p = (u8*)pc_vil_amalloc(32, 0x200);
        st = ((u32)k * 2654435761u + 1u);
        for (i = 0; i < 0x200; i++) { st = st * 1103515245u + 12345u; p[i] = (u8)((st >> 16) & 0xFF); }
        s_vph[k] = p;
    }
    return s_vph[k];
}

static void pc_vil_init(void) {
    FILE* f;
    long len;
    u8* data;
    const u8* p;
    int i, n, m, g, nv, nt;
    if (s_vu_tried) return;
    s_vu_tried = 1;
    if (getenv("AC_NO_WC3_VILLAGERS")) return;
    f = fopen(getenv("AC_VILLAGERS_BIN") ? getenv("AC_VILLAGERS_BIN") : "villagers.bin", "rb");
    if (!f) return;
    fseek(f, 0, SEEK_END); len = ftell(f); fseek(f, 0, SEEK_SET);
    data = (u8*)malloc((size_t)len);
    if (!data || fread(data, 1, (size_t)len, f) != (size_t)len || memcmp(data, "WCV1", 4) != 0) { fclose(f); return; }
    fclose(f);
    n = (int)(data[4] | (data[5] << 8) | (data[6] << 16) | ((u32)data[7] << 24));
    s_vu = (pc_vil_unit*)calloc((size_t)n, sizeof(pc_vil_unit));
    p = data + 8;
    for (i = 0; i < n; i++) {
        pc_vil_unit* u = &s_vu[i];
        int tot;
        memcpy(u->name, p, 32);
        memcpy(&u->scale, p + 32, 4);
        u->nmesh = p[36] | (p[37] << 8); u->nslots = p[38] | (p[39] << 8);
        u->nfr[0] = p[40]; u->nfr[1] = p[41]; u->nfr[2] = p[42];
        p += 44;
        u->meshes = p;
        for (m = 0; m < u->nmesh; m++) {
            int ng = p[2] | (p[3] << 8); p += 4;
            for (g = 0; g < ng; g++) { nv = p[0]; nt = p[1]; p += 2 + nv * 5 + nt * 3; }
        }
        tot = 0;
        for (m = 0; m < 3; m++) { u->frames[m] = (const s16*)p; p += (size_t)u->nfr[m] * u->nslots * 6; tot++; }
    }
    s_vu_roster = p;
    s_vu_n = n;
}

static int pc_vil_pick(int faction, int looks, int npc_id) {
    const u8* p = s_vu_roster;
    int f, l, c;
    unsigned h;
    for (f = 0; f < 2; f++) {
        for (l = 0; l < 6; l++) {
            c = p[0] | (p[1] << 8); p += 2;
            if (f == faction && l == looks) {
                if (c == 0) return -1;
                h = (unsigned)npc_id * 2654435761u; h ^= h >> 15;
                return p[(h % (unsigned)c) * 2] | (p[(h % (unsigned)c) * 2 + 1] << 8);
            }
            p += c * 2;
        }
    }
    return -1;
}

static Gfx* pc_vil_build(pc_vil_inst* in, int ui) {
    pc_vil_unit* u = &s_vu[ui];
    const u8* p = u->meshes;
    Gfx* dl;
    int me, g, k = 0, cap = 16, i, slot = 0;
    for (me = 0; me < u->nmesh; me++) {
        int ng = p[2] | (p[3] << 8); p += 4; cap += 4;
        for (g = 0; g < ng; g++) { int nv = p[0], nt = p[1]; cap += 3 + (nt * 3) / 12 + 1; p += 2 + nv * 5 + nt * 3; }
    }
    dl = (Gfx*)calloc((size_t)cap, sizeof(Gfx));
    in->slotv = (Vtx**)calloc((size_t)u->nslots, sizeof(Vtx*));
    { Gfx t[] = { gsSPTexture(0, 0, 0, G_TX_RENDERTILE, G_ON) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    { Gfx t[] = { gsSPLoadGeometryMode(G_ZBUFFER | G_SHADE | G_SHADING_SMOOTH) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    { Gfx t[] = { gsDPSetRenderMode(G_RM_FOG_SHADE_A, G_RM_AA_ZB_OPA_SURF2) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    { Gfx t[] = { gsDPSetCombineLERP(TEXEL0, 0, SHADE, 0, 0, 0, 0, TEXEL0, PRIMITIVE, 0, COMBINED, 0, 0, 0, 0, COMBINED) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    { Gfx t[] = { gsDPSetPrimColor(0, 128, 255, 255, 255, 255) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    p = u->meshes;
    for (me = 0; me < u->nmesh; me++) {
        int tex = p[0] | (p[1] << 8), ng = p[2] | (p[3] << 8);
        u8* ph = pc_vil_placeholder(tex);
        p += 4;
        { Gfx t[] = { gsDPSetTextureImage_Dolphin(G_IM_FMT_I, G_IM_SIZ_4b, 32, 32, ph) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
        { Gfx t[] = { gsDPSetTile_Dolphin(G_DOLPHIN_TLUT_DEFAULT_MODE, 0, 15, GX_REPEAT, GX_REPEAT, 0, 0) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
        { Gfx t[] = { gsDPSetTileSize(G_TX_RENDERTILE, 0, 0, 124, 124) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
        for (g = 0; g < ng; g++) {
            int nv = p[0], nt = p[1], v, nidx = nt * 3, off;
            Vtx* vt = (Vtx*)pc_vil_amalloc(32, (size_t)((nv * (int)sizeof(Vtx) + 31) & ~31));
            u8 idx[300];
            p += 2;
            for (v = 0; v < nv; v++) {
                s16 uu, ww;
                memcpy(&uu, p, 2); memcpy(&ww, p + 2, 2);
                vt[v].v.ob[0] = 0; vt[v].v.ob[1] = 0; vt[v].v.ob[2] = 0; vt[v].v.flag = 1;
                vt[v].v.tc[0] = uu; vt[v].v.tc[1] = ww;
                vt[v].v.cn[0] = vt[v].v.cn[1] = vt[v].v.cn[2] = p[4]; vt[v].v.cn[3] = 255;
                in->slotv[slot++] = &vt[v];
                p += 5;
            }
            for (v = 0; v < nidx; v++) idx[v] = p[v];
            p += nidx;
            for (; v < 12; v++) idx[v] = 0;
            { Gfx t[] = { gsSPVertex(vt, nv, 0) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
            { Gfx t[] = { gsSPNTrianglesInit_5b(nt, idx[0], idx[1], idx[2], idx[3], idx[4], idx[5], idx[6], idx[7], idx[8]) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
            for (off = 9; off < nidx; off += 12) {
                u8 c[12] = {0};
                for (i = 0; i < 12 && off + i < nidx; i++) c[i] = idx[off + i];
                { Gfx t[] = { gsSPNTriangles_5b(c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11]) }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
            }
        }
    }
    { Gfx t[] = { gsSPEndDisplayList() }; for (i = 0; i < (int)(sizeof(t) / sizeof(Gfx)); i++) dl[k++] = t[i]; }
    return dl;
}

/* draws the villager's Warcraft unit; returns 0 when this actor keeps its original model */
static int pc_vil_try(GAME* game, NPC_ACTOR* nactorx, cKF_SkeletonInfo_R_c* kf_p) {
    ACTOR* actorx = (ACTOR*)nactorx;
    int ui, looks, i, slot, seq, cls, fi;
    pc_vil_inst* in = NULL;
    pc_vil_unit* u;
    f32 drop = 0.0f, seat = 0.28f * 7900.0f * 4.0f / 3.0f, t;
    const s16* fr;
    GRAPH* graph = game->graph;
    pc_vil_init();
    if (s_vu_n == 0 || nactorx->npc_info.animal == NULL) return 0;
    looks = mNpc_GetNpcLooks(actorx);
    if (looks < 0 || looks > 5) return 0;
    ui = pc_vil_pick(pc_wc3_horde() ? 1 : 0, looks, (int)actorx->npc_id);
    if (ui < 0) return 0;
    for (i = 0; i < 40; i++) if (s_vi[i].dl && s_vi[i].npc == (int)actorx->npc_id && s_vi[i].unit == ui) { in = &s_vi[i]; break; }
    if (!in) {
        in = &s_vi[s_vi_next]; s_vi_next = (s_vi_next + 1) % 40;
        in->unit = ui; in->npc = (int)actorx->npc_id; in->dl = pc_vil_build(in, ui);
    }
    u = &s_vu[ui];
    cls = pc_wc3_npc_anim_class(nactorx->draw.animation_id);
    t = (kf_p->frame_control.end_frame > 1.0f) ? kf_p->frame_control.current_frame / kf_p->frame_control.end_frame : 1.0f;
    if (t < 0.0f) t = 0.0f; if (t > 1.0f) t = 1.0f;
    seq = 0;
    switch (cls) {
        case PC_NPC_WALK: seq = 1; break;
        case PC_NPC_ACT: seq = 2; break;
        case PC_NPC_SIT_DOWN: drop = seat * t; break;
        case PC_NPC_SIT: drop = seat; break;
        case PC_NPC_STAND_UP: drop = seat * (1.0f - t); break;
        default: seq = (actorx->speed > 0.3f) ? 1 : 0; break;
    }
    fi = (game->frame_counter / (seq == 0 ? 8 : 3)) % u->nfr[seq];
    fr = u->frames[seq] + (size_t)fi * u->nslots * 3;
    for (slot = 0; slot < u->nslots; slot++) {
        in->slotv[slot]->v.ob[0] = fr[slot * 3]; in->slotv[slot]->v.ob[1] = fr[slot * 3 + 1]; in->slotv[slot]->v.ob[2] = fr[slot * 3 + 2];
    }
    Matrix_push();
    if (drop != 0.0f) Matrix_translate(0.0f, -drop, 0.0f, MTX_MULT);
    Matrix_scale(u->scale, u->scale, u->scale, MTX_MULT);
    OPEN_POLY_OPA_DISP(graph);
    gSPMatrix(POLY_OPA_DISP++, _Matrix_to_Mtx_new(graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    gSPDisplayList(POLY_OPA_DISP++, in->dl);
    CLOSE_POLY_OPA_DISP(graph);
    Matrix_pull();
    return 1;
}
#endif
#endif
